---
Checks: >
  -*,
  clang-analyzer-*,
  bugprone-*,
  performance-*,
  portability-*,
  modernize-*,
WarningsAsErrors: ''
HeaderFilterRegex: '.*(library|backend|frontend)/.*'
FormatStyle: file
CheckOptions:
  - key: readability-identifier-naming.MemberCase
    value: lower_case
  - key: readability-identifier-naming.MemberSuffix
    value: _
...
